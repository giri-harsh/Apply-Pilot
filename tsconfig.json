{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "types": ["chrome", "node", "vite/client", "vitest/globals"],
        "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "tests", "scripts", "*.config.ts"]
}
