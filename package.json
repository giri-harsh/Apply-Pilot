{
  "name": "applypilot-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ApplyPilot AI - personal Chrome MV3 extension that prepares job applications",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:e2e": "node scripts/build.mjs --e2e",
    "build:portals": "node scripts/build-portals.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs --e2e && node scripts/build-portals.mjs && playwright test",
    "clean": "rimraf dist dist-e2e dist-portals test-results",
    "test:live": "node scripts/test-live.mjs",
    "metrics": "node scripts/metrics.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.13.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
